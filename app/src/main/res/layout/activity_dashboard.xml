<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->

        <!-- Grid layout -->

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Bus Pass Dashboard"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <!-- Each card -->
            <!-- View Passes -->
            <LinearLayout
                android:id="@+id/llViewPasses"
                style="@style/DashboardCard">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_pass" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Passes"
                    android:textAlignment="center"
                    android:textStyle="bold" />


            </LinearLayout>

            <!-- Apply New -->
            <LinearLayout
                android:id="@+id/llApplyNew"
                style="@style/DashboardCard">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_add_pass" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apply New"
                    android:textAlignment="center"
                    android:textStyle="bold" />


            </LinearLayout>

            <!-- Renew Pass -->
            <LinearLayout
                android:id="@+id/llRenew"
                style="@style/DashboardCard">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_renew" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Renew Pass"
                    android:textAlignment="center"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/llProfile"
                style="@style/DashboardCard">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_profile" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textAlignment="center"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/llSettings"
                style="@style/DashboardCard">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Logout -->
            <LinearLayout
                android:id="@+id/llLogout"
                style="@style/DashboardCard">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_logout" />

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:textAlignment="center"
                    android:textStyle="bold" />

            </LinearLayout>

        </GridLayout>
    </LinearLayout>
</ScrollView>
